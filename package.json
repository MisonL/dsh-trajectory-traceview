{
  "name": "dsh-trajectory-traceview",
  "version": "0.3.0",
  "description": "轨迹视图插件：在 DeepSeek Harness Web GUI 的「轨迹」标签旁新增可回放的横向时间轴——minimap 总览、搜索、回放、轮次跳转、跟随模式、历史分页、步骤/子调用耗时与吞吐、提示词变更对比、原始请求分析与 Markdown 导出。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFAP/dsh-trajectory-traceview.git"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "trajectory",
    "timeline",
    "replay",
    "minimap",
    "visualization",
    "prompt",
    "plugin"
  ],
  "license": "MIT"
}